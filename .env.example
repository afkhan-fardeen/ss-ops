# =============================================================================
# Seissense Ops Portal — copy to `.env` or `.env.local` and fill every value.
# Never commit real tokens to git (this file is the template only).
# =============================================================================

# --- Shopify Admin API ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REST Admin version: https://shopify.dev/docs/api/release-notes
SHOPIFY_API_VERSION=2024-01
# Optional: extra substrings (comma-separated) to treat an order as COD.
# SHOPIFY_COD_MATCH_EXTRA=pay on delivery

# --- Shopify fulfillment ---
# Ubex is not a native Shopify carrier, so "Other" is the safe default.
SHOPIFY_TRACKING_COMPANY=Other
# Whether Shopify emails the customer when a fulfillment is created.
SHOPIFY_NOTIFY_CUSTOMER=true
# Secret used to verify Shopify webhook HMACs (Phase D).
SHOPIFY_WEBHOOK_SECRET=
# Public base URL used when (re)registering Shopify webhooks. Set this in production
# (e.g. https://ops.seissense.com); locally we fall back to the request origin.
# PORTAL_PUBLIC_URL=

# --- Stock balance (read-only preview) ---
# Optional; default = first active non-legacy Shopify location.
# SHOPIFY_LOCATION_ID=
# Max Ubex inventory rows to load on /stock-balance (paginated, 10 per Ubex page).
# STOCK_BALANCE_MAX_ITEMS=20

# --- Fulfillment queue ---
# Days of order history the /fulfillment page scans.
FULFILLMENT_WINDOW_DAYS=30

# --- Ubex Partner API (UBEX ID column + tracking links) ---
UBEX_EMAIL=ops@example.com
UBEX_API_TOKEN=
# Base URL (default if unset: https://ubex-clients.apis.delivery)
# UBEX_API_BASE_URL=https://ubex-clients.apis.delivery
# Set to 0 if Ubex rejects Bearer and only accepts ?token=
# UBEX_BEARER=0
# Tracking URL template for the UI/email — {id} is replaced with the Ubex tracking id.
UBEX_TRACKING_URL_TEMPLATE=https://ubex.co/tracking/{id}
# Lower defaults since we early-exit once every Shopify last-4 is matched (Phase A perf):
UBEX_MAX_LIST_PAGES=3
UBEX_MAX_DETAIL_FETCHES=150
UBEX_DETAIL_CONCURRENCY=12
# Module-level lookup TTL; keeps the COD/Fulfillment pages sub-second after first hit.
UBEX_LOOKUP_TTL_SECONDS=60
# Per-request timeout (seconds) and retry count for Ubex API calls. When Ubex is slow or
# intermittent the portal now retries with exponential backoff and falls back to the
# Supabase ubex_cache on total failure.
UBEX_REQUEST_TIMEOUT_SECONDS=25
UBEX_MAX_ATTEMPTS=3

# --- Resend (COD list email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Seissense Ops <onboarding@resend.dev>

# --- Auth mode (Phase C) ---
# AUTH_PROVIDER=supabase  → Supabase email/password + magic link
# AUTH_PROVIDER=shared    → legacy single portal password
# unset                   → auto: supabase if NEXT_PUBLIC_SUPABASE_URL is set, else shared
# AUTH_PROVIDER=

# --- Portal password gate (legacy; used when AUTH_PROVIDER=shared) ---
PORTAL_PASSWORD=change-me-in-production

# --- Auto-sync cron (POST /api/sync/auto-fulfill) ---
# Protects the cron endpoint. Vercel Cron sends this automatically as Bearer token.
# Generate: openssl rand -base64 32
CRON_SECRET=replace-with-openssl-rand-base64-32
# Ubex shipment status string that triggers a Shopify fulfillment push.
# Check your actual statuses at: GET /api/meta/statuses?token=YOUR_TOKEN
UBEX_FULFILLED_STATUS=Order Fulfilled

# --- Session cookie HMAC (legacy; used when AUTH_PROVIDER=shared) ---
SESSION_SECRET=replace-with-openssl-rand-base64-32-or-similar

# --- Supabase (Phase B: audit log / FX snapshot / Ubex cache / idempotency) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (only used by `npm run db:push`). Grab it from
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# URL-encode the password (e.g. @ → %40).
SUPABASE_DB_URL=
